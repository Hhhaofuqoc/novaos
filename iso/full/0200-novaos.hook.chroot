#!/bin/bash
# Runs inside the Debian live filesystem during image creation.
set -euo pipefail
APP=/opt/novaos/app
install -m755 "$APP/scripts/nova-settings" /usr/local/bin/nova-settings
install -m755 "$APP/scripts/nova-fetch" /usr/local/bin/nova-fetch
install -m755 "$APP/scripts/nova-logo" /usr/local/bin/nova-logo
install -m644 "$APP/config/nova-center.desktop" /usr/share/applications/nova-center.desktop
# Prepare the Live account in the image before LightDM is started.
# This prevents a first-boot race between user creation and auto-login.
if ! getent passwd nova >/dev/null; then
  useradd --uid 1000 --create-home --shell /bin/bash \
    --comment 'NovaOS Live User' nova
fi
# Disposable LIVE session default; unrelated to the protected browser password.
printf 'nova:live\n' | chpasswd
for group in sudo audio video cdrom plugdev netdev dip; do
  if getent group "$group" >/dev/null; then
    usermod -aG "$group" nova
  fi
done
# Customize the skeleton, then apply it to the pre-created Live user's home.
/usr/bin/python3 "$APP/scripts/enable-branding.py" /etc/skel
cp -an /etc/skel/. /home/nova/
chown -R nova:nova /home/nova
# Never claim this VM is an Android/PRoot kernel: the VM-specific nova-info
# is installed via includes.chroot/usr/local/bin/nova-info.
update-alternatives --set x-terminal-emulator /usr/bin/lxterminal 2>/dev/null || true

#!/bin/bash
# Runs inside the Debian live filesystem during image creation.
set -euo pipefail
APP=/opt/novaos/app
install -m755 "$APP/scripts/nova-settings" /usr/local/bin/nova-settings
install -m755 "$APP/scripts/nova-fetch" /usr/local/bin/nova-fetch
install -m755 "$APP/scripts/nova-logo" /usr/local/bin/nova-logo
install -m644 "$APP/config/nova-center.desktop" /usr/share/applications/nova-center.desktop
# New live user is generated by live-config from /etc/skel.
/usr/bin/python3 "$APP/scripts/enable-branding.py" /etc/skel
# Never claim this VM is an Android/PRoot kernel: the VM-specific nova-info
# is installed via includes.chroot/usr/local/bin/nova-info.
update-alternatives --set x-terminal-emulator /usr/bin/lxterminal 2>/dev/null || true

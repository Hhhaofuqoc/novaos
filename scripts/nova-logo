#!/usr/bin/env python3
"""Print the original NovaOS terminal N, ANSI only when the output is a TTY."""
import os
import sys
from pathlib import Path

DEFAULT = Path('/opt/novaos/app/assets/logos/nova-ascii.txt')
LOCAL = Path(__file__).resolve().parents[1] / 'assets/logos/nova-ascii.txt'


def make_logo(colored=True):
    lines = (DEFAULT if DEFAULT.is_file() else LOCAL).read_text(encoding='utf-8').splitlines()
    if not colored or os.environ.get('NO_COLOR') is not None:
        return '\n'.join(lines)
    left = '\033[1;35m'; middle = '\033[1;34m'; right = '\033[1;36m'; reset = '\033[0m'
    result = []
    for line in lines:
        # Left pillar, diagonal, right pillar: accent colors match the NovaOS SVG.
        if '██' in line and line.startswith('       '):
            # Color the left glyphs, diagonal and right edge independently.
            pivot = line.rfind('██')
            core = line[7:]
            point = max(0, pivot - 7)
            result.append('       ' + left + core[:point] + right + core[point:] + reset)
        elif 'NovaOS' in line:
            result.append(middle + line + reset)
        else:
            result.append(line)
    return '\n'.join(result)


if __name__ == '__main__':
    try:
        print(make_logo(sys.stdout.isatty() and '--no-color' not in sys.argv))
    except BrokenPipeError:
        pass
